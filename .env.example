# Copy to .env for local provider configuration.
# Never commit the real .env file.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

FRONTIER_BASE_URL=https://openrouter.ai/api/v1
FRONTIER_MODEL=inclusionai/ling-3.0-flash-fin:free
FRONTIER_SUPPORTS_RESPONSE_FORMAT=false
FRONTIER_SUPPORTS_TOOL_CALLING=true
FRONTIER_SUPPORTS_REASONING=true
FRONTIER_SUPPORTS_VISION=false

JEV_BASE_URL=https://openrouter.ai/api/v1
JEV_MODEL=inclusionai/ling-3.0-flash-fin:free
JEV_SUPPORTS_RESPONSE_FORMAT=false
JEV_SUPPORTS_TOOL_CALLING=true
JEV_SUPPORTS_REASONING=true
JEV_SUPPORTS_VISION=false
