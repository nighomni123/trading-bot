    assert arm in ARMS, f"unknown arm {arm}"
    cfg = cfg or SimConfig()
    assert cfg.stride >= 1, "stride must be >= 1 (and > 1 is dev-only, never for gates)"
    rng = random.Random(cfg.seed)
